FROM python:3.12-slim

WORKDIR /app

# Install dependencies needed for compiling ML libraries
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
# Ensure API dependencies are included (since they were added later)
RUN pip install --no-cache-dir fastapi pydantic uvicorn python-multipart

# Copy the source code and assets
COPY api/ api/
COPY app/ app/
COPY src/ src/
COPY models/ models/
COPY data/ data/

# Expose the API port
EXPOSE 8000

# Run Uvicorn server
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
